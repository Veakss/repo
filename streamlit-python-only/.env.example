# Service ports
BACKEND_PORT=8010
SIDECAR_PORT=4001
STREAMLIT_PORT=8501

# Service URLs
ORCHESTRATOR_SIDECAR_URL=http://127.0.0.1:4001
BACKEND_BASE_URL=http://127.0.0.1:8010

# Workspace and storage
WORKSPACE_ROOT=/Users/victor/Documents/continue-better/agent_playground
ARTIFACT_ROOT=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=continue_better_python

# Generic provider fallback
LLM_PROVIDER_MODE=auto
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite-preview-09-2025
LLM_PROFILE=openrouter_gemini_flash_lite

# Optional title model override
TITLE_LLM_BASE_URL=
TITLE_LLM_API_KEY=
TITLE_LLM_MODEL=

# Provider catalog
PROVIDER_CATALOG_PATH=config/providers.yaml

# Thales settings
THALES_BASE_URL=
THALES_API_KEY=
THALES_MODEL=
THALES_PROFILE=thales_mistral_small

# Runtime features
ENABLE_FILE_TOOLS=1
ENABLE_TERMINAL_TOOLS=1
ENABLE_WEB_SEARCH=1
ENABLE_RAG=1
ENABLE_APP_ACTIONS=1
ENABLE_TOOL_CLARIFICATION=1

# Development defaults
DEFAULT_LANGUAGE=auto
